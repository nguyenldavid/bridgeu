---
import { getCollection, render } from 'astro:content';
import EntityLogo from '../../../components/EntityLogo.astro';
import Base from '../../../layouts/Base.astro';
import AppCTA from '../../../components/AppCTA.astro';
import ReportIssue from '../../../components/ReportIssue.astro';
import { causeName, cityName, statusName } from '../../../lib/taxonomy';
import { isActiveStatus, oppHref } from '../../../lib/listings';

export async function getStaticPaths() {
  const [orgs, opps] = await Promise.all([getCollection('organizations'), getCollection('opportunities')]);
  return orgs.map((entry) => {
    const [city, slug] = entry.id.split('/');
    return { params: { city, slug }, props: { entry, opps: opps.filter((o) => o.data.org === entry.id) } };
  });
}

const { entry, opps } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const city = cityName(d.city);
const sorted = [...opps].sort((a, b) => Number(isActiveStatus(b.data.status)) - Number(isActiveStatus(a.data.status)) || a.data.title.localeCompare(b.data.title));
---

<Base title={`${d.name}: volunteer in ${city}`} description={d.summary || `Volunteer opportunities at ${d.name} in ${city}.`} appCity={city}>
  <div class="container-page py-8 sm:py-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/organizations" class="hover:text-brand-700">Organizations</a>
      <span class="mx-1.5 text-line">/</span>
      <a href={`/organizations/${d.city}`} class="hover:text-brand-700">{city}</a>
    </nav>
    <div class="mt-6 grid gap-10 lg:grid-cols-[1fr_340px]">
      <article>
        <header data-reveal class="flex items-start gap-5">
          {d.logo && <EntityLogo src={d.logo} />}
          <div>
            <p class="font-medium text-brand-700">{city}</p>
            <h1 class="mt-1 text-3xl font-extrabold tracking-tight text-balance sm:text-4xl">{d.name}</h1>
            <div class="mt-3 flex flex-wrap gap-1.5">
              {d.status && d.status !== 'accepting' && <span class="rounded-md bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-800 ring-1 ring-amber-200 ring-inset">{statusName(d.status)}</span>}
              {d.causes.map((c) => <a href={`/volunteering/${d.city}/${c}`} class="pill hover:bg-brand-100">{causeName(c)}</a>)}
            </div>
          </div>
        </header>
        <div class="prose-bridge mt-8"><Content /></div>

        <section class="mt-10">
          <h2 class="text-xl font-bold">Opportunities at {d.name}</h2>
          {sorted.length === 0 ? (
            <p class="mt-3 text-muted">No roles are listed right now. {d.website && <>Check <a href={d.website} class="font-semibold text-brand-700 underline" rel="noopener" target="_blank">their website</a> or </>}get alerts in the app when they post.</p>
          ) : (
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {sorted.map((o) => (
                <li>
                  <a href={oppHref(o)} class:list={['flex h-full flex-col rounded-xl border border-line p-4 transition hover:border-brand-300 hover:shadow-md', !isActiveStatus(o.data.status) && 'opacity-60']}>
                    <span class="font-semibold leading-snug">{o.data.title}</span>
                    {o.data.summary && <span class="mt-1 line-clamp-2 text-sm text-muted">{o.data.summary}</span>}
                    {o.data.status !== 'accepting' && <span class="mt-2 text-xs font-semibold text-amber-700">{statusName(o.data.status)}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
        <ReportIssue />
      </article>
      <aside class="lg:pt-2">
        <div data-reveal style="--reveal-i: 2" class="space-y-4 lg:sticky lg:top-24">
          {d.website && (
            <div class="rounded-2xl border border-line p-5 shadow-sm">
              <h2 class="font-bold">Website</h2>
              <a href={d.website} target="_blank" rel="noopener" class="btn-secondary mt-3 w-full">Visit {d.name} ↗</a>
            </div>
          )}
          <div class="rounded-2xl bg-brand-700 p-5 text-white">
            <h2 class="font-bold">Follow {d.name}</h2>
            <p class="mt-1 text-sm text-brand-100">Get notified when they post new volunteer roles in {city}.</p>
            <AppCTA placement="org-detail" label="Get alerts in the app" city={city} variant="inverse" class="mt-4 w-full" />
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>
