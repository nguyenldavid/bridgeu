---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import AppBanner from '../../components/AppBanner.astro';
import ArticleRow from '../../components/blog/ArticleRow.astro';
import { byline, deckOf, formatDate, getPosts, isGeneratedDeck, readingTime, topicsOf, type Post } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry, all: posts } }));
}

type Props = { entry: Post; all: Post[] };
const { entry, all } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const topics = topicsOf(entry);
const primary = topics[0];
const deck = deckOf(entry);
const isMed = primary?.slug === 'medical-school';
const related = all.filter((p) => p.id !== entry.id && primary && primary.match(p)).slice(0, 3);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: deck,
  datePublished: d.date.toISOString(),
  author: d.authors.map((name) => ({ '@type': 'Person', name })),
  publisher: { '@type': 'Organization', name: 'BridgeU' },
};
---

<Base title={d.title} description={deck || d.summary} ogType="article" jsonLd={ld}>
  <article>
    <header class="container-page pt-10 sm:pt-16" data-reveal-stagger>
      <nav data-reveal aria-label="Breadcrumb" class="flex gap-2 text-sm font-medium text-muted">
        <a href="/blog" class="hover:text-ink">Blog</a>
        {primary && (<><span aria-hidden="true" class="text-ink/20">/</span><a href={`/blog/topic/${primary.slug}`} class="text-brand-700 hover:text-brand-900">{primary.name}</a></>)}
      </nav>
      <div data-reveal class="mt-6 max-w-4xl">
        <h1 class="text-4xl leading-[1.04] font-bold tracking-[-0.03em] text-balance sm:text-6xl">{d.title}</h1>
        {deck && isGeneratedDeck(entry) && <p class="mt-6 max-w-[58ch] text-xl leading-relaxed text-pretty text-muted">{deck}</p>}
      </div>
      <div data-reveal class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-3 border-y border-ink/10 py-5 text-sm">
        {d.authors.length > 0 && (
          <p><span class="text-muted">By </span><span class="font-semibold">{byline(entry)}</span></p>
        )}
        <p class="text-muted"><time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time></p>
        <p class="text-muted">{readingTime(entry)}</p>
      </div>
    </header>

    {d.cover && (
      <div class="container-page mt-10" data-reveal="scale" style="--reveal-i: 3">
        <Image src={d.cover} alt="" width={1600} height={686} fit="cover" loading="eager" class="aspect-[21/9] w-full rounded-xl object-cover" />
      </div>
    )}

    <div class="container-page mt-12 sm:mt-16">
      <div class="prose-article mx-auto max-w-[42rem]">
        <Content />
      </div>

      {topics.length > 0 && (
        <div class="mx-auto mt-14 flex max-w-[42rem] flex-wrap items-center gap-2 border-t border-ink/10 pt-6">
          <span class="mr-2 text-sm text-muted">Filed under</span>
          {topics.map((t) => (
            <a href={`/blog/topic/${t.slug}`} class="rounded-lg px-3 py-1.5 text-sm font-medium text-ink ring-1 ring-ink/12 transition-colors hover:bg-canvas hover:ring-ink/25">{t.name}</a>
          ))}
        </div>
      )}
    </div>
  </article>

  <div class="container-page">
    <AppBanner
      class="mt-20"
      placement={isMed ? 'med-school-post' : 'blog-post'}
      title={isMed ? 'Strengthen your application' : 'Find opportunities like these'}
      text={isMed ? 'Discover research and volunteering roles that build the experiences admissions committees look for.' : 'Get new research and volunteering opportunities delivered to you in the BridgeU app.'}
      label="Explore the app"
    />

    {related.length > 0 && (
      <section class="mt-20">
        <div class="flex items-end justify-between gap-4 pb-6">
          <h2 class="text-2xl font-bold tracking-tight sm:text-3xl">More on {primary!.name.toLowerCase()}</h2>
          <a href={`/blog/topic/${primary!.slug}`} class="text-sm font-semibold text-brand-700 hover:text-brand-900">View all</a>
        </div>
        {related.map((p) => <ArticleRow post={p} />)}
      </section>
    )}
  </div>
</Base>

<script>
  // Copy buttons on ```template blocks.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-template]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const body = btn.closest('figure')?.querySelector<HTMLElement>('.tpl-body');
      if (!body) return;
      const text = [...body.querySelectorAll('p')].map((p) => p.innerText).join('\n\n');
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        btn.textContent = 'Press ⌘C to copy';
        const range = document.createRange();
        range.selectNodeContents(body);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
      }
      setTimeout(() => (btn.textContent = 'Copy'), 2000);
    });
  });
</script>
