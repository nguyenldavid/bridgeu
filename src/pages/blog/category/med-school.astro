---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import PostList from '../../../components/PostList.astro';
import AppBanner from '../../../components/AppBanner.astro';
import hero from '../../../assets/site/medical_care.png';

const posts = (await getCollection('blog', (p) => !p.data.draft && (p.data.section === 'med-school' || p.data.tags.some((t) => /medical school/i.test(t))))).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Medical school application advice" description="Casper tips, ABS and supplementary essay advice for Canadian medical school applicants.">
  <PageHero eyebrow="Med school advice" title="Medical school application advice" intro="Casper, ABS and supplementary application tips from current Canadian medical students." image={hero} breadcrumbs={[{ href: '/blog', label: 'Blog' }]} />
  <div class="container-page py-10">
    <PostList posts={posts} />
    <AppBanner class="mt-16" placement="med-school-index" title="Build your application with BridgeU" text="Find research and volunteering opportunities that strengthen your med school application." label="Explore the app" />
  </div>
</Base>
