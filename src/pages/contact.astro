---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import support from '../assets/site/instant_support.png';
---

<Base title="Contact" description="Send BridgeU feedback, report outdated information, or reach the team at hello@bridgeu.ca.">
  <PageHero
    eyebrow="Contact"
    title="We’d love to hear from you"
    intro="Whether you have suggestions, found a bug, or noticed outdated information, we appreciate you taking the time to reach out."
    image={support}
  >
    <a href="https://bridgeu-feedback.paperform.co" class="btn-primary btn-lg" rel="noopener">Submit feedback ↗</a>
    <a href="mailto:hello@bridgeu.ca" class="btn-secondary btn-lg">Email hello@bridgeu.ca</a>
  </PageHero>
  <div class="container-page grid gap-5 py-12 md:grid-cols-3">
    <a href="https://bridgeu-feedback.paperform.co" rel="noopener" class="rounded-3xl border border-line p-6 transition hover:border-brand-300 hover:shadow-md">
      <h2 class="font-bold">Feedback & bug reports</h2>
      <p class="mt-1 text-sm text-muted">Report inaccurate listings, broken links or anything that isn’t working.</p>
    </a>
    <a href="/submit" class="rounded-3xl border border-line p-6 transition hover:border-brand-300 hover:shadow-md">
      <h2 class="font-bold">List an opportunity</h2>
      <p class="mt-1 text-sm text-muted">Organizations and community members can submit new opportunities.</p>
    </a>
    <a href="mailto:hello@bridgeu.ca" class="rounded-3xl border border-line p-6 transition hover:border-brand-300 hover:shadow-md">
      <h2 class="font-bold">Special inquiries</h2>
      <p class="mt-1 text-sm text-muted">Partnerships, press or anything else: hello@bridgeu.ca</p>
    </a>
  </div>
</Base>
