---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <section class="container-page py-24 text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-4xl font-extrabold tracking-tight">We couldn’t find that page</h1>
    <p class="mx-auto mt-4 max-w-lg text-muted">The listing may have been removed or moved. Try browsing current opportunities instead.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/volunteering" class="btn-primary btn-lg">Volunteering</a>
      <a href="/research" class="btn-secondary btn-lg">Research</a>
      <a href="/" class="btn-secondary btn-lg">Home</a>
    </div>
  </section>
</Base>
