---
import Wordmark from './Wordmark.astro';
import { appUrl } from '../lib/app-link';

type Props = { appCity?: string };
const { appCity } = Astro.props;

const columns = [
  {
    title: 'Explore',
    links: [
      { href: '/research', label: 'Research' },
      { href: '/volunteering/kingston', label: 'Kingston volunteering' },
      { href: '/volunteering/london', label: 'London volunteering' },
      { href: '/organizations', label: 'Organizations' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { href: '/blog', label: 'Blog' },
      { href: '/blog/category/med-school', label: 'Med school advice' },
      { href: '/faq', label: 'FAQ' },
    ],
  },
  {
    title: 'BridgeU',
    links: [
      { href: '/about', label: 'About us' },
      { href: '/submit', label: 'List an opportunity' },
      { href: '/contact', label: 'Contact' },
      { href: '/careers', label: 'Careers' },
    ],
  },
];
---

<footer class="mt-24 border-t border-line bg-canvas pb-24 sm:pb-0">
  <div class="container-page grid gap-10 py-14 md:grid-cols-[1.4fr_repeat(3,1fr)]">
    <div class="max-w-xs">
      <Wordmark class="text-xl" />
      <p class="mt-3 text-sm text-muted">Bridging the gap to meaningful opportunities near you. By the community, for the community.</p>
      <a href={appUrl('footer', { city: appCity })} class="btn-primary mt-5" data-cta="footer">Get opportunity alerts</a>
    </div>
    {
      columns.map((col) => (
        <div>
          <h2 class="text-sm font-semibold">{col.title}</h2>
          <ul class="mt-3 space-y-2 text-sm text-muted">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="hover:text-brand-700">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-line">
    <div class="container-page flex flex-col gap-2 py-6 text-xs text-muted sm:flex-row sm:justify-between">
      <p>© {new Date().getFullYear()} BridgeU. Opportunities are crowdsourced; always confirm details with the organization.</p>
      <p>
        <a href="mailto:hello@bridgeu.ca" class="hover:text-brand-700">hello@bridgeu.ca</a> ·
        <a href="https://www.linkedin.com/company/bridgeu-ca/" class="hover:text-brand-700">LinkedIn</a>
      </p>
    </div>
  </div>
</footer>
