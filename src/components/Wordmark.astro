---
// Official BridgeU logo (src/assets/brand). Inlined so it stays crisp; the black lettering follows `currentColor`.
import logoFull from '../assets/brand/Logo_Full.svg?raw';

type Props = { class?: string };
const { class: className = 'h-10' } = Astro.props;

const svg = logoFull
  .replace('<svg ', `<svg role="img" aria-label="BridgeU" class="${className} w-auto text-ink" `)
  .replace(/fill="black"/g, 'fill="currentColor"');
---

<Fragment set:html={svg} />
