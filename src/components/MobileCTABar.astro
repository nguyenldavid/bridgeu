---
import { appUrl } from '../lib/app-link';

type Props = { appCity?: string };
const { appCity } = Astro.props;
---

<div id="mobile-cta" class="fixed inset-x-3 bottom-3 z-40 flex items-center gap-2 rounded-2xl bg-brand-800 p-2 pl-4 text-white shadow-2xl sm:hidden" data-dismissed="false">
  <p class="flex-1 text-sm font-medium">Get new opportunities{appCity ? ` in ${appCity}` : ''} sent to you</p>
  <a href={appUrl('mobile-bar', { city: appCity })} class="btn bg-white px-4 py-2 text-brand-800" data-cta="mobile-bar">Join free</a>
  <button type="button" class="flex size-9 items-center justify-center rounded-full text-brand-100 hover:bg-white/10" aria-label="Dismiss" data-dismiss>
    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"></path></svg>
  </button>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById('mobile-cta');
    if (!bar) return;
    try {
      if (localStorage.getItem('bu-cta-dismissed') === '1') bar.remove();
    } catch (e) {}
    var btn = bar.querySelector('[data-dismiss]');
    if (btn)
      btn.addEventListener('click', function () {
        bar.remove();
        try {
          localStorage.setItem('bu-cta-dismissed', '1');
        } catch (e) {}
      });
  })();
</script>
