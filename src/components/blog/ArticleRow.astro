---
import { Image } from 'astro:assets';
import { byline, deckOf, formatDate, formatOf, readingTime, topicsOf, type Post } from '../../lib/blog';

type Props = { post: Post; featured?: boolean };
const { post, featured = false } = Astro.props;
const d = post.data;
const href = `/blog/${post.id}`;
const topic = topicsOf(post)[0];
const deck = deckOf(post);
---

{
  featured ? (
    <article data-reveal class="group grid gap-8 border-t border-ink/10 pt-8 pb-10 md:grid-cols-12 md:items-center md:gap-12" data-format={formatOf(post)}>
      <a href={href} class="block overflow-hidden rounded-xl md:col-span-7" tabindex="-1" aria-hidden="true">
        {d.cover && <Image src={d.cover} alt="" width={1200} height={750} fit="cover" loading="eager" class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.015]" />}
      </a>
      <div class="md:col-span-5">
        {topic && <a href={`/blog/topic/${topic.slug}`} class="text-sm font-semibold text-brand-700 hover:text-brand-900">{topic.name}</a>}
        <h2 class="mt-3 text-3xl leading-[1.1] font-bold tracking-tight text-balance sm:text-[2.5rem]">
          <a href={href} class="decoration-brand-600 decoration-2 underline-offset-[6px] group-hover:underline">{d.title}</a>
        </h2>
        {deck && <p class="mt-4 text-lg leading-relaxed text-muted">{deck}</p>}
        <p class="mt-6 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
          {d.authors.length > 0 && <span class="font-semibold text-ink">{byline(post)}</span>}
          <time datetime={d.date.toISOString().slice(0, 10)}>{formatDate(d.date)}</time>
          <span>{readingTime(post)}</span>
        </p>
      </div>
    </article>
  ) : (
    <article data-reveal class="group grid grid-cols-[minmax(0,1fr)_5.5rem] gap-x-5 gap-y-3 border-t border-ink/10 py-8 sm:grid-cols-[minmax(0,1fr)_11rem] md:grid-cols-[9rem_minmax(0,1fr)_14rem] md:gap-x-10" data-format={formatOf(post)}>
      <div class="hidden text-sm text-muted md:block">
        <time datetime={d.date.toISOString().slice(0, 10)} class="block font-medium text-ink">{formatDate(d.date, 'short')}</time>
        <span class="mt-1 block">{formatOf(post)}</span>
      </div>
      <div class="min-w-0">
        {topic && <a href={`/blog/topic/${topic.slug}`} class="text-sm font-semibold text-brand-700 hover:text-brand-900">{topic.name}</a>}
        <h2 class="mt-2 text-xl leading-snug font-bold tracking-tight text-balance sm:text-2xl">
          <a href={href} class="decoration-brand-600 decoration-2 underline-offset-4 group-hover:underline">{d.title}</a>
        </h2>
        {deck && <p class="mt-3 line-clamp-3 max-w-[62ch] leading-relaxed text-muted sm:line-clamp-2">{deck}</p>}
        <p class="mt-4 flex flex-wrap gap-x-4 gap-y-1 text-sm text-muted">
          {d.authors.length > 0 && <span class="font-medium text-ink">{byline(post)}</span>}
          <time datetime={d.date.toISOString().slice(0, 10)} class="md:hidden">{formatDate(d.date, 'short')}</time>
          <span>{readingTime(post)}</span>
        </p>
      </div>
      <a href={href} class="block self-start overflow-hidden rounded-lg" tabindex="-1" aria-hidden="true">
        {d.cover && <Image src={d.cover} alt="" width={448} height={336} fit="cover" class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />}
      </a>
    </article>
  )
}
